<!DOCTYPE html>
<html>
  <head>
    <title>Test App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script type="module" src="/assets/input-attachment.js"></script>
    <% if params[:turbo] %>
      <script type="module" src="/assets/turbo.js"></script>
    <% end %>
    <% if params[:form_persistence] %>
      <script type="module">
        import FormPersistence from "/assets/form-persistence.min.js"
        document.querySelectorAll('form[id]').forEach(function(form) {
          FormPersistence.persist(form, {
            afterSerialize: function(form, data) {
              form.querySelectorAll('input-attachment[name]').forEach(function(el) {
                data[el.getAttribute('name')] = el.value;
              });
              return data;
            },
            beforeDeserialize: function(form, data) {
              form.querySelectorAll('input-attachment[name]').forEach(function(el) {
                var name = el.getAttribute('name');
                if (data[name]) {
                  el.value = data[name];
                  delete data[name];
                }
              });
              return data;
            },
          });
        });
      </script>
    <% end %>
  </head>
  <body>
    <div class="alert"><%= flash.alert %></div>
    <div class="notice"><%= flash.notice %></div>
    <%= yield %>
  </body>
</html>
