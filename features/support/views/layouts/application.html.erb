<!DOCTYPE html>
<html>
  <head>
    <title>Test App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script type="module" src="/assets/input-attachment.js"></script>
    <% if params[:turbo] %>
      <script type="module" src="/assets/turbo.js"></script>
    <% end %>
    <% if params[:form_persistence] %>
      <script defer src="/assets/form-persistence.min.js"></script>
    <% end %>
    <script defer>
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('form[id]').forEach(function(form) {
          if (typeof FormPersistence !== 'undefined') {
            FormPersistence.persist(form);
          }
        });
      });
    </script>
  </head>
  <body>
    <div class="alert"><%= flash.alert %></div>
    <div class="notice"><%= flash.notice %></div>
    <%= yield %>
  </body>
</html>
