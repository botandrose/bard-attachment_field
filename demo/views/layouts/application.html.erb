<!DOCTYPE html>
<html lang="en">
  <head>
    <title>bard-attachment_field demo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script type="module" src="<%= asset_path("input-attachment.js") %>"></script>
    <style>
      :root { color-scheme: light dark; }
      body {
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.5;
        max-width: 760px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 4rem;
        color: #1a1a1a;
        background: #fafafa;
      }
      a { color: #2563eb; }
      h1 { margin-bottom: 0.25rem; }
      .lede { color: #555; margin-top: 0; }
      .back { display: inline-block; margin-bottom: 1rem; font-size: 0.9rem; }
      .demo-list { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
      .demo-list li {
        border: 1px solid #e2e2e2;
        border-radius: 8px;
        background: #fff;
        padding: 0.9rem 1rem;
      }
      .demo-list a { font-weight: 600; font-size: 1.05rem; text-decoration: none; }
      .demo-list p { margin: 0.3rem 0 0; color: #555; font-size: 0.9rem; }
      pre {
        background: #1e1e2e; color: #cdd6f4; padding: 0.75rem 1rem;
        border-radius: 8px; overflow-x: auto; font-size: 0.85rem;
      }
      .desc { color: #555; }
      label { font-weight: 600; display: block; margin-bottom: 0.25rem; }
      input[type=text], input[type=number] {
        font: inherit; padding: 0.35rem 0.5rem; border: 1px solid #ccc; border-radius: 6px;
      }
      input[type=submit] {
        font: inherit; font-weight: 600; padding: 0.5rem 1.1rem; cursor: pointer;
        background: #2563eb; color: #fff; border: 0; border-radius: 6px;
      }
      .field { margin: 1.25rem 0; }
      .notice { background: #dcfce7; color: #166534; padding: 0.6rem 0.9rem; border-radius: 6px; }
      .errors { background: #fee2e2; color: #991b1b; padding: 0.6rem 0.9rem; border-radius: 6px; }
      .errors ul { margin: 0; padding-left: 1.2rem; }
      .saved { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #e2e2e2; }
      .saved img, .saved video { max-width: 220px; max-height: 220px; border-radius: 6px; display: block; }
      fieldset { border: 1px dashed #bbb; border-radius: 8px; }
    </style>
  </head>
  <body>
    <% if flash[:notice] %><p class="notice"><%= flash[:notice] %></p><% end %>
    <%= yield %>
  </body>
</html>
